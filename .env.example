# Datenbank (docker compose up -d startet Postgres auf Port 5433)
DATABASE_URL=postgresql://tcms:tcms@localhost:5433/tcms

# Signiert das Sitzungs-Cookie. In jeder Installation durch einen eigenen,
# langen Zufallswert ersetzen (z. B. `openssl rand -hex 32`).
SESSION_SECRET=bitte-durch-einen-langen-zufallswert-ersetzen

# Ablage der Nachweisdateien (relativ zum Repo-Root oder absolut).
TCMS_STORAGE_DIR=.data/nachweise

# Entwicklungs-Anmeldung per Personenauswahl. Nur für Entwicklung und Demo;
# in Produktion verweigert die App sie, solange dieser Schalter nicht auf 1 steht.
TCMS_DEV_LOGIN=1

# Fiktives "Heute" für die Demo-Daten (Stand der Mockups: 16.10.2026).
# Leer lassen oder entfernen, damit die App mit dem echten Datum rechnet.
TCMS_DEMO_TODAY=2026-10-16
