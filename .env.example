# Tax-CMS – Vorlage für die lokale Entwicklung (Demo-Oberfläche apps/web).
# `pnpm env:lokal` legt daraus die .env an (Modus 0600) und erzeugt SESSION_SECRET und
# TCMS_CODE_SCHLUESSEL zufällig; vorhandene gültige Werte bleiben, Werte erscheinen in keiner
# Ausgabe. .env nie einchecken (das Skript bricht ab, wenn git sie nicht ignoriert).

# Datenbank (docker compose up -d startet Postgres auf 127.0.0.1:5433 und legt die
# Rollen per packages/db/prisma/init/01_bootstrap.sql an; Passwörter nur für Entwicklung).
# Laufzeit: tcms_app (NOBYPASSRLS, nur DML). Die App verweigert eine Verbindung, deren
# Rolle Superuser ist, BYPASSRLS hat oder Tabellen besitzt (ADR 0001 §4).
DATABASE_URL=postgresql://tcms_app:tcms_app@127.0.0.1:5433/tcms
# Migrationen und Seed: Eigentümerrolle tcms_owner.
DATABASE_OWNER_URL=postgresql://tcms_owner:tcms_owner@127.0.0.1:5433/tcms

# Signiert das Sitzungs-Cookie der Demo-Anmeldung. Pflicht: eigener Zufallswert,
# mindestens 32 Zeichen; `pnpm env:lokal` erzeugt ihn (sonst z. B. `openssl rand -hex 32`).
# Platzhalter weist die App ab.
SESSION_SECRET=

# Ablage der Nachweisdateien der Demo (relativ zum Repo-Root oder absolut).
TCMS_STORAGE_DIR=.data/nachweise

# Fiktives "Heute" für die Demo-Daten (Stand der Mockups: 16.10.2026). Wirkt nur in der
# Demo-Oberfläche, nie im Dienst. Leer lassen, damit die Demo mit dem echten Datum rechnet.
TCMS_DEMO_TODAY=2026-10-16

# Dienst (apps/api, ADR 0001 §3 und §8). Die drei Werte hier sind Platzhalter, mit denen der
# Dienst nicht startet (fail closed); `pnpm env:lokal` ersetzt nur den Code-Schlüssel. Er nutzt
# DATABASE_URL von oben (tcms_app); mit NODE_ENV=production verweigert er auch die
# Entwicklungspasswörter.
# Dienst-Tokens der kanzleikonsole, kommagetrennt (Rotation: alter und neuer Token
# gleichzeitig), je mindestens 32 Zeichen, z. B. `openssl rand -base64 48`.
TCMS_SERVICE_TOKENS=bitte-durch-einen-zufaelligen-dienst-token-ersetzen
# Schlüssel der Bestätigungscodes für Freigaben (HMAC-SHA-256, nie in der Datenbank),
# kommagetrennt wie die Tokens: der erste signiert neue Codes, alle prüfen (Rotation mit
# Überlappung von mindestens 7 Tagen, ADR 0001 §8). Je 32–512 Zeichen aus A-Z a-z 0-9 - . _ ~ + /,
# nie gleich einem Dienst-Token. Pflicht für den Dienst; die Demo-Oberfläche nutzt ihn ebenfalls,
# sobald ein Code angefordert oder geprüft wird. Lokal erzeugt ihn `pnpm env:lokal` (32
# Zufallsbytes, base64url) und lässt einen vorhandenen gültigen Schlüssel unverändert – ein neuer
# Schlüssel ließe offene Codes ablaufen. Von Hand: `openssl rand -base64 32`.
TCMS_CODE_SCHLUESSEL=bitte-durch-einen-zufaelligen-code-schluessel-ersetzen
# Öffentliche Ed25519-Schlüssel der kanzleikonsole: kid=<base64 SPKI-DER>, kommagetrennt.
# Erzeugen mit `pnpm akteur:schluessel` (der private Schlüssel gehört nur in die kanzleikonsole).
TCMS_ACTOR_PUBLIC_KEYS=kk-bitte-ersetzen=bitte-durch-die-ausgabe-von-akteur-schluessel-ersetzen
# Bindung des Dienstes, nur im internen Netz erreichbar machen (Standard 0.0.0.0:3200).
# HOST=0.0.0.0
# PORT=3200

# Die Demo-Anmeldung (Personenauswahl) gibt es nur außerhalb von Produktion; mit
# NODE_ENV=production ist sie immer verweigert (TS-01). Einen Schalter dafür gibt es nicht.
