// =============================================================================
// Tax-CMS — Prisma-Schema (headless Dienst, ADR 0001)
//
// Mandantentrennung (ADR 0001 §4): Jede Tabelle trägt `tenant_id` (Kanzlei der
// kanzleikonsole). PostgreSQL-RLS erzwingt die Trennung für die Laufzeitrolle
// `tcms_app`; die Policies stehen in der Init-Migration, nicht hier. Der
// Spaltenstandard übernimmt den Tenant aus dem Transaktionskontext
// (`mitTenant`), Anwendungscode setzt `tenantId` deshalb nicht selbst.
// Fremdschlüssel zwischen Fachtabellen laufen über (tenant_id, id): ein Verweis
// auf ein Objekt eines anderen Tenants ist damit schon in der Datenbank
// unmöglich (FK-Prüfungen umgehen RLS, die zusammengesetzten Schlüssel nicht).
//
// Versionierte Objekte führen ihre fachlichen Attribute in *Stand-Tabellen mit
// gueltigAb/gueltigBis und einer Versionsnummer. Höchstens ein Stand je Objekt
// ist offen (gueltigBis NULL); das sichern Teilindizes in der Migration (TS-05).
// Abgeschlossene Durchführungen und Audit-Einträge werden nie geändert.
//
// Personenfelder (`durchfuehrendId`, `erfasstVon`, …) enthalten IDs der
// kanzleikonsole (Mitarbeiter oder Mandantenkontakt), ADR 0001 §5. Eine
// Personentabelle gibt es im Tax-CMS nicht.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Mandanten (Anker der kanzleikonsole) und Rollen der Mandantenseite
// ---------------------------------------------------------------------------

enum MandantRolle {
  GESETZLICHER_VERTRETER
  TAX_COMPLIANCE_BEAUFTRAGTER
  MITARBEITER
}

/// Mandant der kanzleikonsole. `id` ist deren Mandanten-ID (kein Standardwert).
model Mandant {
  id         String                @id @db.Uuid
  tenantId   String                @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  name       String
  rechtsform String
  datevNr    String?
  aktiv      Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @default(now()) @updatedAt
  programme  TcmsProgramm[]
  kontakte   MandantKontaktRolle[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
}

/// Rolle eines Mandantenkontakts (ID der kanzleikonsole) beim Mandanten
/// (ADR 0001 §5). Ohne aktive Rolle hat ein Mandantenkontakt keinen Zugriff.
model MandantKontaktRolle {
  id        String       @id @default(cuid())
  tenantId  String       @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  mandantId String       @db.Uuid
  mandant   Mandant      @relation(fields: [tenantId, mandantId], references: [tenantId, id])
  kontaktId String       @db.Uuid
  rolle     MandantRolle
  funktion  String?
  aktiv     Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  @@unique([tenantId, mandantId, kontaktId, rolle])
  @@index([tenantId, kontaktId])
}

// ---------------------------------------------------------------------------
// Tax-CMS-Programm, Teilbereich, Profil, Ziele
// ---------------------------------------------------------------------------

enum Turnus {
  KEIN
  JAEHRLICH
  QUARTALSWEISE
  MONATLICH
}

enum ProgrammStatus {
  ENTWURF
  AKTIV
}

/// Höchstens ein Programm je Mandant (TS-05): eindeutig über (tenant_id, mandantId).
model TcmsProgramm {
  id                     String                @id @default(cuid())
  tenantId               String                @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  mandantId              String                @db.Uuid
  mandant                Mandant               @relation(fields: [tenantId, mandantId], references: [tenantId, id])
  paketId                String
  paketVersion           String
  status                 ProgrammStatus        @default(ENTWURF)
  /// Erklärungsturnus für „jede Periode" (FP) der Häufigkeitsmatrix.
  erklaerungsTurnus      Turnus                @default(MONATLICH)
  angemessenheitStichtag DateTime?             @db.Date
  wirksamAb              DateTime?             @db.Date
  wirksamBis             DateTime?             @db.Date
  /// Entwurfsstand des Einrichtungsassistenten (Schritte 1–5).
  setupEntwurf           Json?
  version1Am             DateTime?
  createdAt              DateTime              @default(now())
  teilbereiche           Teilbereich[]
  profile                ProfilStand[]
  risiken                Risiko[]
  kontrollen             Kontrolle[]
  feststellungen         Feststellung[]
  ereignisse             Ereignis[]
  laender                LandStand[]
  beschreibungen         BeschreibungVersion[]
  freigaben              Freigabe[]

  @@unique([tenantId, id])
  @@unique([tenantId, mandantId])
}

model Teilbereich {
  id           String           @id @default(cuid())
  tenantId     String           @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  programmId   String
  programm     TcmsProgramm     @relation(fields: [tenantId, programmId], references: [tenantId, id])
  name         String
  abgrenzung   String
  einschluesse String[]
  ausschluesse String[]
  createdAt    DateTime         @default(now())
  ziele        ComplianceZiel[]

  @@unique([tenantId, id])
  @@index([tenantId, programmId])
}

model ProfilStand {
  id          String       @id @default(cuid())
  tenantId    String       @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  programmId  String
  programm    TcmsProgramm @relation(fields: [tenantId, programmId], references: [tenantId, id])
  /// Laufende Nummer je Programm (TS-05: eindeutig, kein Gabeln).
  version     Int
  antworten   Json
  gueltigAb   DateTime
  gueltigBis  DateTime?
  erstelltVon String?
  createdAt   DateTime     @default(now())

  @@unique([tenantId, programmId, version])
  @@index([tenantId, programmId, gueltigAb])
}

enum Klasse {
  GERING
  MITTEL
  HOCH
  KRITISCH
}

enum FreigabeStand {
  ENTWURF
  AUSSTEHEND
  FREIGEGEBEN
}

model ComplianceZiel {
  id                String        @id @default(cuid())
  tenantId          String        @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  teilbereichId     String
  teilbereich       Teilbereich   @relation(fields: [tenantId, teilbereichId], references: [tenantId, id])
  text              String
  wesentlichkeitEur Int
  risikoappetit     Klasse        @default(MITTEL)
  freigabe          FreigabeStand @default(ENTWURF)
  freigegebenAm     DateTime?
  freigegebenVon    String?
  createdAt         DateTime      @default(now())

  @@index([tenantId, teilbereichId])
}

// ---------------------------------------------------------------------------
// Risiken (versioniert)
// ---------------------------------------------------------------------------

enum Herkunft {
  KATALOG
  BERATER
}

enum RisikoEntscheidung {
  VORGESCHLAGEN
  UEBERNOMMEN
  ABGELEHNT
}

enum RisikoFreigabe {
  IDENTIFIZIERT
  BEWERTET
  ZUR_FREIGABE
  FREIGEGEBEN
}

enum Schaden {
  N
  M
  H
}

enum Wahrscheinlichkeit {
  SELTEN
  MOEGLICH
  WAHRSCHEINLICH
  HAEUFIG
}

enum GovernanceTyp {
  FP
  FF
  IN
}

model Risiko {
  id                     String               @id @default(cuid())
  tenantId               String               @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  programmId             String
  programm               TcmsProgramm         @relation(fields: [tenantId, programmId], references: [tenantId, id])
  code                   String
  herkunft               Herkunft             @default(KATALOG)
  kern                   Boolean              @default(false)
  entscheidung           RisikoEntscheidung   @default(VORGESCHLAGEN)
  vorschlagsgrund        String?
  ablehnungsgrund        String?
  freigabe               RisikoFreigabe       @default(IDENTIFIZIERT)
  freigabeEingereichtVon String?
  freigegebenVon         String?
  freigegebenAm          DateTime?
  ownerId                String?
  /// Durch Ereignis-Triage zur Neubewertung markiert.
  neuBewerten            Boolean              @default(false)
  aktivAb                DateTime
  inaktivAb              DateTime?
  createdAt              DateTime             @default(now())
  staende                RisikoStand[]
  kontrollen             RisikoKontrolle[]
  uebersteuerungen       Uebersteuerung[]
  feststellungen         FeststellungRisiko[]

  @@unique([tenantId, id])
  @@unique([tenantId, programmId, code])
}

model RisikoStand {
  id           String             @id @default(cuid())
  tenantId     String             @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  risikoId     String
  risiko       Risiko             @relation(fields: [tenantId, risikoId], references: [tenantId, id])
  /// Laufende Nummer je Risiko (TS-05: eindeutig, kein Gabeln).
  version      Int
  titel        String
  fehlerquelle String
  folge        String
  normanker    Json
  s            Schaden
  w            Wahrscheinlichkeit
  r            Int
  gt           GovernanceTyp
  modell       String
  gueltigAb    DateTime
  gueltigBis   DateTime?
  erstelltVon  String?
  createdAt    DateTime           @default(now())

  @@unique([tenantId, risikoId, version])
  @@index([tenantId, risikoId, gueltigAb])
}

enum UebersteuerungSicht {
  DESIGN
  BETRIEB
}

enum UebersteuerungStatus {
  BEANTRAGT
  FREIGEGEBEN
  ABGELEHNT
  AUFGEHOBEN
}

model Uebersteuerung {
  id             String               @id @default(cuid())
  tenantId       String               @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  risikoId       String
  risiko         Risiko               @relation(fields: [tenantId, risikoId], references: [tenantId, id])
  sicht          UebersteuerungSicht
  klasse         Klasse
  berechnet      Klasse
  begruendung    String
  status         UebersteuerungStatus @default(BEANTRAGT)
  beantragtVon   String
  beantragtAm    DateTime             @default(now())
  entschiedenVon String?
  entschiedenAm  DateTime?

  @@index([tenantId, risikoId])
}

// ---------------------------------------------------------------------------
// Kontrollen (versioniert) und Durchführungen
// ---------------------------------------------------------------------------

enum KontrollArt {
  P
  D
  K
}

enum Ausfuehrung {
  M
  IT
  A
}

enum Partei {
  KANZLEI
  MANDANT
}

enum Design {
  ANGEMESSEN
  NICHT_BEURTEILT
  MANGEL
}

model Kontrolle {
  id              String            @id @default(cuid())
  tenantId        String            @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  programmId      String
  programm        TcmsProgramm      @relation(fields: [tenantId, programmId], references: [tenantId, id])
  code            String
  herkunft        Herkunft          @default(KATALOG)
  aktivAb         DateTime
  entfallenAb     DateTime?
  createdAt       DateTime          @default(now())
  staende         KontrolleStand[]
  risiken         RisikoKontrolle[]
  durchfuehrungen Durchfuehrung[]

  @@unique([tenantId, id])
  @@unique([tenantId, programmId, code])
}

model KontrolleStand {
  id                       String          @id @default(cuid())
  tenantId                 String          @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  kontrolleId              String
  kontrolle                Kontrolle       @relation(fields: [tenantId, kontrolleId], references: [tenantId, id])
  version                  Int
  titel                    String
  ziel                     String
  art                      KontrollArt
  ausfuehrung              Ausfuehrung
  vorlageTurnus            Turnus
  vorlageAnlass            Boolean
  /// Abweichung unter die Matrixfrequenz (nur mit Begründung + zweiter Person).
  abweichungTurnus         Turnus?
  abweichungAnlass         Boolean?
  abweichungBegruendung    String?
  abweichungFreigegebenVon String?
  partei                   Partei
  schluessel               Boolean
  durchfuehrendId          String?
  vertretungId             String?
  gegenzeichnerId          String?
  /// Gegenzeichnung durch zweite Person beim Mandanten statt Kanzlei.
  gegenzeichnungMandant    Boolean         @default(false)
  nachweis                 String
  mindestNachweise         Int
  schritte                 Json
  kennzahlen               Json
  toleranzEur              Decimal?        @db.Decimal(14, 2)
  faelligNachTagen         Int
  design                   Design          @default(NICHT_BEURTEILT)
  designVon                String?
  designAm                 DateTime?
  designBegruendung        String?
  gueltigAb                DateTime
  gueltigBis               DateTime?
  erstelltVon              String?
  createdAt                DateTime        @default(now())
  durchfuehrungen          Durchfuehrung[]

  @@unique([tenantId, id])
  @@unique([tenantId, kontrolleId, version])
  @@index([tenantId, kontrolleId, gueltigAb])
}

model RisikoKontrolle {
  tenantId    String    @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  risikoId    String
  risiko      Risiko    @relation(fields: [tenantId, risikoId], references: [tenantId, id])
  kontrolleId String
  kontrolle   Kontrolle @relation(fields: [tenantId, kontrolleId], references: [tenantId, id])

  @@id([risikoId, kontrolleId])
  @@index([tenantId, kontrolleId])
}

enum DurchfuehrungStatus {
  GEPLANT
  IN_DURCHFUEHRUNG
  ZUR_GEGENZEICHNUNG
  ZURUECKGEWIESEN
  OHNE_BEFUND
  MIT_BEFUND
  ENTFALLEN
}

enum Ergebnis {
  OHNE_BEFUND
  MIT_BEFUND
}

model Durchfuehrung {
  id                   String              @id @default(cuid())
  tenantId             String              @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  kontrolleId          String
  kontrolle            Kontrolle           @relation(fields: [tenantId, kontrolleId], references: [tenantId, id])
  kontrolleStandId     String
  kontrolleStand       KontrolleStand      @relation(fields: [tenantId, kontrolleStandId], references: [tenantId, id])
  periodeLabel         String
  periodeVon           DateTime            @db.Date
  periodeBis           DateTime            @db.Date
  faelligAm            DateTime            @db.Date
  status               DurchfuehrungStatus @default(GEPLANT)
  ausserplanmaessig    Boolean             @default(false)
  anlass               String?
  ereignisFolgeId      String?
  /// [{ erledigt: boolean, kommentar: string }] je Schritt der Kontrollversion.
  schritte             Json                @default("[]")
  /// { [kennzahlKey]: { wert: number | null, bemerkung: string, erklaert: boolean } }
  werte                Json                @default("{}")
  ergebnis             Ergebnis?
  ergebnisKommentar    String?
  durchgefuehrtVon     String?
  begonnenAm           DateTime?
  eingereichtAm        DateTime?
  /// Bei Mandanten-Gegenzeichnung: erste Übermittlung im Portal.
  mandantBestaetigtVon String?
  gegengezeichnetVon   String?
  abgeschlossenAm      DateTime?
  zurueckgewiesenVon   String?
  zurueckweisungsgrund String?
  entfallenBegruendung String?
  entfallenVon         String?
  entfallenAm          DateTime?
  nachtragZuId         String?
  createdAt            DateTime            @default(now())
  nachweise            Nachweis[]
  feststellungen       Feststellung[]      @relation("FeststellungQuelle")
  nachkontrolleFuer    Feststellung[]      @relation("Nachkontrolle")

  @@unique([tenantId, id])
  @@index([tenantId, kontrolleId, periodeVon])
  @@index([tenantId, faelligAm])
}

/// Verweis auf einen Nachweis (ADR 0001 §6). Im Dienst ist `dokumentId` die
/// Dokument-ID der kanzleikonsole; die Demo-Oberfläche legt Dateien lokal ab
/// und speichert hier den relativen Ablagepfad.
model Nachweis {
  id              String        @id @default(cuid())
  tenantId        String        @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  durchfuehrungId String
  durchfuehrung   Durchfuehrung @relation(fields: [tenantId, durchfuehrungId], references: [tenantId, id])
  dokumentId      String
  dateiname       String
  mime            String
  groesse         Int
  sha256          String
  gesperrt        Boolean       @default(false)
  hochgeladenVon  String
  hochgeladenAm   DateTime      @default(now())

  @@index([tenantId, durchfuehrungId])
}

// ---------------------------------------------------------------------------
// Feststellungen und Maßnahmen
// ---------------------------------------------------------------------------

enum FeststellungStatus {
  ERFASST
  IN_WUERDIGUNG
  MASSNAHMEN_OFFEN
  NACHKONTROLLE
  GESCHLOSSEN
  VERWORFEN
}

enum FeststellungQuelle {
  KONTROLLE
  EREIGNIS
  STICHPROBE
  HINWEIS
  AUSSENPRUEFUNG
}

enum FeststellungKlasse {
  DESIGNMANGEL
  DURCHFUEHRUNGSMANGEL
  STEUERLICHER_FEHLER
  HINWEIS
}

enum Auswirkung {
  JA
  NEIN
  UNKLAR
}

enum P153Entscheidung {
  BERICHTIGUNG
  KEINE_PFLICHT
  WEITERE_KLAERUNG
  UEBERGABE
}

model Feststellung {
  id                     String                 @id @default(cuid())
  tenantId               String                 @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  programmId             String
  programm               TcmsProgramm           @relation(fields: [tenantId, programmId], references: [tenantId, id])
  nummer                 String
  titel                  String
  sachverhalt            String
  quelle                 FeststellungQuelle
  quelleText             String
  durchfuehrungId        String?
  durchfuehrung          Durchfuehrung?         @relation("FeststellungQuelle", fields: [tenantId, durchfuehrungId], references: [tenantId, id], onDelete: Restrict)
  ereignisId             String?
  klasse                 FeststellungKlasse
  schwere                Klasse
  auswirkung             Auswirkung
  ursache                String?
  status                 FeststellungStatus     @default(ERFASST)
  vertraulich            Boolean                @default(false)
  p153Entscheidung       P153Entscheidung?
  p153Begruendung        String?
  p153Frist              DateTime?              @db.Date
  p153EntschiedenVon     String?
  p153EntschiedenAm      DateTime?
  nachkontrolleId        String?
  nachkontrolle          Durchfuehrung?         @relation("Nachkontrolle", fields: [tenantId, nachkontrolleId], references: [tenantId, id], onDelete: Restrict)
  verwerfenBegruendung   String?
  verwerfenBeantragtVon  String?
  verwerfenBestaetigtVon String?
  erfasstVon             String
  erfasstAm              DateTime               @default(now())
  geschlossenAm          DateTime?
  risiken                FeststellungRisiko[]
  erklaerungen           BetroffeneErklaerung[]
  massnahmen             Massnahme[]

  @@unique([tenantId, id])
  @@unique([tenantId, programmId, nummer])
}

model FeststellungRisiko {
  tenantId       String       @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  feststellungId String
  feststellung   Feststellung @relation(fields: [tenantId, feststellungId], references: [tenantId, id])
  risikoId       String
  risiko         Risiko       @relation(fields: [tenantId, risikoId], references: [tenantId, id])

  @@id([feststellungId, risikoId])
  @@index([tenantId, risikoId])
}

model BetroffeneErklaerung {
  id             String       @id @default(cuid())
  tenantId       String       @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  feststellungId String
  feststellung   Feststellung @relation(fields: [tenantId, feststellungId], references: [tenantId, id])
  steuerart      String
  land           String
  zeitraum       String
  auswirkungEur  Decimal?     @db.Decimal(14, 2)

  @@index([tenantId, feststellungId])
}

enum MassnahmeStatus {
  OFFEN
  ERLEDIGT
}

model Massnahme {
  id              String          @id @default(cuid())
  tenantId        String          @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  feststellungId  String
  feststellung    Feststellung    @relation(fields: [tenantId, feststellungId], references: [tenantId, id])
  /// Laufende Wiedervorlage-Nummer (#123), je Kanzlei (Tenant).
  wiedervorlageNr Int
  beschreibung    String
  verantwortlich  String
  frist           DateTime        @db.Date
  status          MassnahmeStatus @default(OFFEN)
  erledigtAm      DateTime?
  erledigtVon     String?
  createdAt       DateTime        @default(now())

  @@unique([tenantId, wiedervorlageNr])
  @@index([tenantId, feststellungId])
}

// ---------------------------------------------------------------------------
// Ereignisse
// ---------------------------------------------------------------------------

enum EreignisStatus {
  NEU
  IN_TRIAGE
  ERLEDIGT
  VERWORFEN
}

enum EreignisQuelle {
  PORTAL
  KONTROLLE
  STAMMDATEN
  RSS
  MANUELL
}

enum FolgeArt {
  RISIKO_NEU_BEWERTEN
  RISIKO_AKTIVIEREN
  KONTROLLE_AUSSERPLANMAESSIG
  PROFIL_AENDERN
  FESTSTELLUNG_ANLEGEN
  HINWEIS
}

enum FolgeStatus {
  VORGESCHLAGEN
  ANGELEGT
  ERLEDIGT
  VERWORFEN
}

model Ereignis {
  id                   String          @id @default(cuid())
  tenantId             String          @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  programmId           String
  programm             TcmsProgramm    @relation(fields: [tenantId, programmId], references: [tenantId, id])
  /// `<Jahr>-T-<nnnn>`, je Kanzlei (Tenant) eindeutig.
  nummer               String
  typ                  String
  titel                String
  beschreibung         String
  quelle               EreignisQuelle
  gemeldetVon          String?
  gemeldetAm           DateTime        @default(now())
  ereignisDatum        DateTime        @db.Date
  status               EreignisStatus  @default(NEU)
  verwerfenBegruendung String?
  triagiertVon         String?
  triagiertAm          DateTime?
  folgen               EreignisFolge[]

  @@unique([tenantId, id])
  @@unique([tenantId, nummer])
  @@index([tenantId, programmId])
}

model EreignisFolge {
  id         String      @id @default(cuid())
  tenantId   String      @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  ereignisId String
  ereignis   Ereignis    @relation(fields: [tenantId, ereignisId], references: [tenantId, id])
  art        FolgeArt
  ziel       String?
  text       String
  zustaendig String?
  frist      DateTime?   @db.Date
  status     FolgeStatus @default(VORGESCHLAGEN)
  objektId   String?
  erledigtAm DateTime?

  @@index([tenantId, ereignisId])
}

// ---------------------------------------------------------------------------
// Länder-Monitor
// ---------------------------------------------------------------------------

enum DatenQuelle {
  MANUELL
  CSV
}

model LandStand {
  id                      String       @id @default(cuid())
  tenantId                String       @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  programmId              String
  programm                TcmsProgramm @relation(fields: [tenantId, programmId], references: [tenantId, id])
  land                    String
  fernverkaeufeLfdEur     Decimal      @db.Decimal(14, 2)
  fernverkaeufeVorjahrEur Decimal      @db.Decimal(14, 2)
  lagerSeit               String?
  oss                     Boolean
  lokaleUstNr             Boolean
  zmRelevant              Boolean      @default(false)
  steuersaetzeGeprueftAm  DateTime?    @db.Date
  stand                   DateTime     @db.Date
  quelle                  DatenQuelle  @default(MANUELL)
  erfasstVon              String?
  createdAt               DateTime     @default(now())

  @@index([tenantId, programmId, land, stand])
}

// ---------------------------------------------------------------------------
// CMS-Beschreibung und Freigaben
// ---------------------------------------------------------------------------

enum BeschreibungStatus {
  ENTWURF
  KANZLEI_REVIEW
  BEIM_MANDANTEN
  FREIGEGEBEN
  ABGELOEST
}

model BeschreibungVersion {
  id                    String             @id @default(cuid())
  tenantId              String             @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  programmId            String
  programm              TcmsProgramm       @relation(fields: [tenantId, programmId], references: [tenantId, id])
  nummer                String
  status                BeschreibungStatus @default(ENTWURF)
  /// [{ key, titel, text }] — Freitext je Abschnitt (0 Teilbereich, 1–7, Anhang).
  abschnitte            Json
  reviewAngefordertVon  String?
  reviewAngefordertAm   DateTime?
  reviewVon             String?
  reviewAm              DateTime?
  freigabeAngefordertAm DateTime?
  freigegebenVon        String?
  freigegebenAm         DateTime?
  /// Eingefrorener Inhalt inkl. gerenderter lebender Bausteine.
  snapshot              Json?
  snapshotSha256        String?
  createdAt             DateTime           @default(now())
  erstelltVon           String?

  @@unique([tenantId, programmId, nummer])
}

enum FreigabeArt {
  ZIELE
  BESCHREIBUNG
  RISIKOAKZEPTANZ
  AUFKLAERUNG
  /// Kenntnisnahme (z. B. Steuerrichtlinie); kein Freigabevorbehalt.
  KENNTNISNAHME
}

enum FreigabeStatus {
  OFFEN
  FREIGEGEBEN
  ABGELEHNT
}

model Freigabe {
  id             String         @id @default(cuid())
  tenantId       String         @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  programmId     String
  programm       TcmsProgramm   @relation(fields: [tenantId, programmId], references: [tenantId, id])
  art            FreigabeArt
  refId          String
  titel          String
  /// Darzustellender Inhalt (Markdown-light) bei Kenntnisnahmen und Akzeptanzen.
  inhalt         String?
  angefordertVon String
  angefordertAm  DateTime       @default(now())
  empfaengerId   String
  codeHash       String?
  codeAblauf     DateTime?
  status         FreigabeStatus @default(OFFEN)
  anmerkung      String?
  erledigtAm     DateTime?

  @@index([tenantId, programmId])
  @@index([tenantId, empfaengerId, status])
}

/// Postausgang der Entwicklungsumgebung (kein Mailversand in Stufe 1).
model Nachricht {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  an        String
  betreff   String
  text      String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------
// Audit (Hashkette je Tenant, Kettenversion 2 – ADR 0001 §4, TS-08, TS-10)
// ---------------------------------------------------------------------------

/// Nur anhängen: Die Laufzeitrolle hat SELECT und INSERT, kein UPDATE/DELETE.
/// (tenant_id, prevHash) ist eindeutig: Die Kette eines Tenants kann nicht
/// verzweigen, auch wenn die Sperre einmal fehlte.
model AuditEvent {
  seq           Int      @id @default(autoincrement())
  tenantId      String   @default(dbgenerated("tcms_aktueller_tenant()")) @map("tenant_id") @db.Uuid
  kettenVersion Int
  at            DateTime
  actorId       String?
  actorName     String
  aktion        String
  objektTyp     String
  objektId      String
  programmId    String?
  detail        Json
  prevHash      String
  hash          String

  @@unique([tenantId, hash])
  @@unique([tenantId, prevHash])
  @@index([tenantId, seq])
  @@index([tenantId, programmId, seq])
  @@index([tenantId, objektTyp, objektId])
}

// ---------------------------------------------------------------------------
// Einmal-IDs der Akteursbestätigung (ADR 0001 §3.2, §4)
// ---------------------------------------------------------------------------

/// Nicht mandantengebunden, ohne RLS. Laufzeitrolle: nur INSERT, SELECT, DELETE.
/// Der Dienst (apps/api) greift per Raw-SQL zu; die Struktur ist Vertrag.
model AkteurJti {
  jti String   @id
  exp DateTime @db.Timestamptz(6)

  @@map("akteur_jti")
}
