{
  "name": "tcms",
  "private": true,
  "version": "0.1.0",
  "description": "Tax-CMS nach IDW PS 980 – eigenständige Anwendung (Stufe 1, Branchenpaket E-Commerce)",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm --filter @tcms/web dev",
    "build": "pnpm --filter @tcms/web --filter @tcms/api run build",
    "start": "pnpm --filter @tcms/web start",
    "api": "pnpm --filter @tcms/api start",
    "akteur:schluessel": "node scripts/akteur-schluessel.mjs",
    "env:lokal": "node scripts/lokale-env.mjs",
    "vertrag:export": "node scripts/vertrag-export.mjs",
    "image:pruefen": "node scripts/pruefe-dockerfile.mjs",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @tcms/db generate",
    "db:migrate": "pnpm --filter @tcms/db migrate:dev",
    "db:deploy": "pnpm --filter @tcms/db migrate:deploy",
    "db:seed": "pnpm --filter @tcms/db seed",
    "db:reset": "pnpm --filter @tcms/db reset",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "6.0.3"
  }
}
