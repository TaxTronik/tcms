# Tax-CMS-Dienst (apps/api). Alle Werte sind Platzhalter: Der Dienst startet
# mit keinem davon (fail closed). Echte Werte nie einchecken.

# Dienst-Tokens der kanzleikonsole, kommagetrennt (Rotation: alter und neuer
# Token gleichzeitig). Je mindestens 32 Zeichen, z. B. `openssl rand -base64 48`.
TCMS_SERVICE_TOKENS=bitte-durch-einen-zufaelligen-dienst-token-ersetzen

# Öffentliche Ed25519-Schlüssel der kanzleikonsole: kid=<base64 SPKI-DER>,
# kommagetrennt. Erzeugen mit `pnpm akteur:schluessel`.
TCMS_ACTOR_PUBLIC_KEYS=kk-bitte-ersetzen=bitte-durch-die-ausgabe-von-akteur-schluessel-ersetzen

# Laufzeitverbindung als `tcms_app` (kein Superuser, kein BYPASSRLS).
DATABASE_URL=postgresql://tcms_app:bitte-ersetzen@127.0.0.1:5433/tcms

# Bindung des HTTP-Servers (nur internes Netz).
HOST=0.0.0.0
PORT=3200
